generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Kindergarten {
  id              Int       @id @default(autoincrement())
  kinderCode      String    @unique @map("kinder_code")
  officeedu       String    @map("officeedu")
  subofficeedu    String    @map("subofficeedu")
  kindername      String    @map("kindername")
  establish       String?   @map("establish")
  edate           String?   @map("edate")
  odate           String?   @map("odate")
  zipcode         String?   @map("zipcode")
  addr            String?   @map("addr")
  telno           String?   @map("telno")
  hpaddr          String?   @map("hpaddr")
  opertime        String?   @map("opertime")
  clcnt3          Int       @default(0) @map("clcnt3")
  clcnt4          Int       @default(0) @map("clcnt4")
  clcnt5          Int       @default(0) @map("clcnt5")
  mixclcnt        Int       @default(0) @map("mixclcnt")
  shclcnt         Int       @default(0) @map("shclcnt")
  prmstfcnt       Int       @default(0) @map("prmstfcnt")
  ag3fpcnt        Int       @default(0) @map("ag3fpcnt")
  ag4fpcnt        Int       @default(0) @map("ag4fpcnt")
  ag5fpcnt        Int       @default(0) @map("ag5fpcnt")
  mixfpcnt        Int       @default(0) @map("mixfpcnt")
  spcnfpcnt       Int       @default(0) @map("spcnfpcnt")
  ppcnt3          Int       @default(0) @map("ppcnt3")
  ppcnt4          Int       @default(0) @map("ppcnt4")
  ppcnt5          Int       @default(0) @map("ppcnt5")
  mixppcnt        Int       @default(0) @map("mixppcnt")
  shppcnt         Int       @default(0) @map("shppcnt")
  pbnttmng        String?   @map("pbnttmng")
  lttdcdnt        Float?    @map("lttdcdnt")
  lngtcdnt        Float?    @map("lngtcdnt")

  totalClassCount Int       @default(0) @map("total_class_count")
  totalChildCount Int       @default(0) @map("total_child_count")

  sidoCode        String?   @map("sido_code")
  sggCode         String?   @map("sgg_code")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([sidoCode])
  @@index([sggCode])
  @@index([kindername])
  @@index([establish])
  @@index([lttdcdnt, lngtcdnt])
  @@map("kindergartens")
}

model RegionCode {
  id          Int      @id @default(autoincrement())
  sidoCode    String   @map("sido_code")
  sidoName    String   @map("sido_name")
  sggCode     String?  @map("sgg_code")
  sggName     String?  @map("sgg_name")

  @@unique([sidoCode, sggCode])
  @@index([sidoCode])
  @@map("region_codes")
}

model Childcare {
  id              Int       @id @default(autoincrement())
  stcode          String    @unique @map("stcode")         // 어린이집 코드 (11자리)
  crname          String    @map("crname")                 // 어린이집명
  crtypename      String?   @map("crtype_name")            // 유형 (국공립/민간/가정/법인/직장/협동)
  crstatusname    String?   @map("crstatus_name")          // 상태 (정상/휴지/폐지)
  sidoname        String?   @map("sido_name")
  sigunguname     String?   @map("sigungu_name")
  arcode          String?   @map("arcode")                 // 시군구 코드 (5자리)
  zipcode         String?   @map("zipcode")
  craddr          String?   @map("craddr")
  crtelno         String?   @map("crtelno")
  crfaxno         String?   @map("crfaxno")
  crhome          String?   @map("crhome")
  crcapat         Int       @default(0) @map("crcapat")    // 정원
  crchcnt         Int       @default(0) @map("crchcnt")    // 현원
  la              Float?    @map("la")                     // 위도
  lo              Float?    @map("lo")                     // 경도
  nrtrroomcnt     Int       @default(0) @map("nrtrroomcnt") // 보육실 수
  cctvinstlcnt    Int       @default(0) @map("cctvinstlcnt") // CCTV 수
  chcrtescnt      Int       @default(0) @map("chcrtescnt") // 통학차량 수
  crspec          String?   @map("crspec")                 // 특징
  crcnfmdt        String?   @map("crcnfmdt")               // 인가일
  frstcnfmdt      String?   @map("frstcnfmdt")             // 최초인가일

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([arcode])
  @@index([crname])
  @@index([crtypename])
  @@index([la, lo])
  @@map("childcares")
}

model SyncJob {
  id          Int       @id @default(autoincrement())
  status      String    @default("pending") @map("status")
  jobType     String    @default("full") @map("job_type")
  targetCode  String?   @map("target_code")
  totalCount  Int       @default(0) @map("total_count")
  errorCount  Int       @default(0) @map("error_count")
  errorLog    String?   @map("error_log")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("sync_jobs")
}
